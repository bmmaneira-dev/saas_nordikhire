# Copia este ficheiro para .env.local e preenche com os valores reais.
# Nunca commites .env.local (já está no .gitignore).

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave secreta (service_role / sb_secret_...) — nunca expor ao cliente.
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic — console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# Domínio real usado para construir links (ex: reset de password).
# Em produção, define o domínio real do site.
SITE_URL=http://localhost:3000

# ElevenLabs — opcional. Sem isto, a entrevista de prática usa a voz do
# browser (Web Speech API) como fallback automático.
# elevenlabs.io → Settings → API Keys. O plano gratuito não permite usar
# vozes via API (precisa do plano Starter ou superior).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
